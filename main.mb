struct Vec<T> {
    data: T*,
    size: usize,
    capacity: usize,
}

impl Vec<T> {
    pub fn init() -> Vec<T> {
        return Vec<T> {
            data: null,
            size: 0, 
            capacity: 1,
        };
    }


    pub fn (v:Vec<T>*) add<U>(x:U,y:U) -> U {
        return x + y;
    }

    pub fn (v: Vec<T>*) push (data: T) -> void {
        
    } 

    pub fn square<U>(x:U) -> U {
        return x * x;
    }
}


pub fn add<T>(x:T,y:T) -> T {
    return x + y;
}


fn main() -> int {
    let vec = Vec<int>::init();
    let r = vec.add<int>(1,2);
    r = add<float>(1.2,2.1);
    r = Vec<int>::square<int>(1);
    return 0;
}

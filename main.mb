struct std {}

impl std {
    pub fn allocate<T> (size:usize)-> T* {
        let x: T;
        return &x;
    }
}


struct LinkedList<T> {
    root: Node<T>,
}

struct Node<T> {
    data: T,
    next: Node<T>*,
}

impl Node<T> {
   pub fn (n:Node<int>*) get_data() -> T {
        return n->data;
    }
}

fn add(x:int,y:int) -> int {
    return x + y;
}


fn main() -> int {

    let node = Node<int>{
        data: 1,
        next: std::allocate<Node<int>>(1 as usize)
    }; 


    let n_data = node.get_data();

    add(1,n_data);



    return 0;
}

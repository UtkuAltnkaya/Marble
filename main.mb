enum ExpressionTypes {
    Binary,
    Unary
}


impl ExpressionTypes {
    pub fn (e:ExpressionTypes) to_int() -> int {
        if (e == ExpressionTypes::Binary) {
            return 0;
        }
        return 1;
    }
}


fn main() -> int {
    let expressionType = ExpressionTypes::Binary;

    let x = expressionType.to_int();

    let y = x + 1;

    return 0;
}

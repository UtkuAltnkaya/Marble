struct Person {
    name: char*
}

struct ClassRoom {
    pub teacher: Person
}


impl Person {
    pub fn (p:Person*) get_name() -> char* {
        return p->name;
    }
}

impl ClassRoom {
    pub fn (c:ClassRoom*) start_course() -> void {
        let t = &c->teacher;
    }

    pub fn (c:ClassRoom*) get_teacher() -> Person {
        return c->teacher;
    }
}



fn main() -> int {
    let classRoom  = ClassRoom {
        teacher: Person {
            name: null,
        }
    };

    let teacher_name = classRoom.get_teacher().get_name();

    return 0;
}

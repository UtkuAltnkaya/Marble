struct std {}

struct Vec<T> {
    data: T*,
    size: usize,
    capacity: usize   
}

impl std {
    pub fn allocate<T>(size: usize) -> T* {
        return null;
    }

    pub fn deallocate<T>(ptr: T*) -> void {}
}


impl Vec<T> {

    pub fn allocate() -> Vec<T>* {
        let vec = std::allocate<Vec<T>>(1);
        vec->data = std::allocate<T>(1);
        vec->size = 0;
        vec->capacity = 1;
        return vec;
    }
}


fn main () -> void  {
    let vec1 = Vec<int>::allocate();
    
}
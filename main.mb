struct std {}

struct Person {
    pub age: int
}

struct ClassRoom {
    pub teacher: Person,
    pub students: Person*
}


impl std {
    pub fn allocate<T>(size:usize) -> T* {
        return null;
    }

    pub fn deallocate<T>(ptr:T*) -> void {

    }
}

impl Person {
    pub fn init() -> Person {
        return Person {
            age: 42
        };
    }

    pub fn (p: const Person*) get_age() -> const int* {
        return &p->age;
    }
}

impl ClassRoom {
    pub fn init() -> ClassRoom {
        return ClassRoom {
            teacher: Person::init(),
            students: std::allocate<Person>(10)
        };
    }

    pub fn (c:ClassRoom*) get_teacher() -> Person* {
        return &c->teacher;
    }
}




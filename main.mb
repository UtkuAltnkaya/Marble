struct Person {
    pub name: str,
    pub age: int,
    pub job: str,
}

fn someFunc(p:Person*) -> void {
    p->age = 42;
}


fn main() -> int {
    let person:Person = Person {
        name: "Utku",
        age: 24,
        job: "Computer Engineer"
    };
    someFunc(&person);
    return person.age;
}

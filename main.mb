struct Person {
    pub name: char*
}

struct ClassRoom {
    pub teacher: Person
}


impl Person {
    pub fn (p:Person*) get_name() -> char* {
        return p->name;
    }
}


fn main() -> int {
    let classRoom =  ClassRoom {
        teacher: Person {
            name: null
        }
    };

    let name = classRoom.teacher.get_name();

    return 1;
}
